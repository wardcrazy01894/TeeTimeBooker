// main.bicepparam.dev — development environment parameter values.
// Deploy: az deployment group create \
//   --resource-group rg-teetime-dev \
//   --template-file infra/bicep/main.bicep \
//   --parameters @infra/bicep/main.bicepparam.dev
//
// See: infra/AZURE_PLAN.md §4 (parameter strategy), §12 (open questions)

using 'main.bicep'

param envName = 'dev'
param location = 'eastus2'

// containerImage is a placeholder for local/manual deploy only — CI injects containerImage
// inline (resolved from the shared ACR login server); this placeholder is never read by CI.
// Dev uses the SEPARATE `teetime-dev` repo in the shared ACR (§2.1). Format:
// <sharedAcrLoginServer>/teetime-dev:<tag>
param containerImage = 'PLACEHOLDER_ACR_LOGIN_SERVER/teetime-dev:dev'

// Budget params are NOT set here. budget.bicep is subscription-scoped and
// deployed separately. See AZURE_PLAN.md §9.2.

param acrSku = 'Basic'
param kvSku = 'standard'

// Shared-ACR consolidation (full-repo-scan cost finding): dev does NOT create its own ACR
// (~$5/mo saved). It pulls from the single SHARED ACR owned by prod (the stable env) via a
// cross-RG AcrPull grant. CI resolves the shared ACR name at deploy time; these values are
// for manual/local deploys. acrOwnerEnv defaults 'prod', so envName='dev' is a non-owner.
// See AZURE_PLAN.md §2.1 + infra/bicep/modules/acr-pull-cross-rg.bicep.
param sharedAcrName = 'teetimeprod4jteeywdlnz5e'
param sharedAcrResourceGroup = 'rg-teetime-prod'

// Permanent dry-run in dev — the bot performs no real booking POSTs. Dev MUST
// stay true until production cutover. See AZURE_PLAN.md §10.3.
param dryRun = true

// Dev disables Key Vault purge protection so the vault (and the whole RG) can be
// torn down and recreated during iteration. Prod keeps it true (irreversible
// once enabled). See AZURE_PLAN.md §7.4, §11.
param enablePurgeProtection = false

// Cost-killswitch safety latch. Defaults false (schedules run normally).
// If the $50 budget killswitch fires: set this to true in BOTH param files and push.
// CI parses THIS value out of the param file and passes it into every deploy, so
// effectiveEnableSchedules (= enableSchedules && !killswitchFired) goes false and no
// subsequent merge can re-arm the cron schedules until this bit is cleared.
// WARNING: do NOT clear this param until the overspend root cause is resolved.
// See: infra/COST_KILLSWITCH_PLAN.md §2/Item2 + §5 (operator runbook)
param killswitchFired = false

// Cron schedules on/off. Default true (booking + watch jobs auto-fire). Set false to
// deploy the jobs on Manual triggers only — used to silence dev once prod is live so two
// envs don't hit ForeUP on the same credentials. CI parses this from the param file (the
// other half of effectiveEnableSchedules). See AZURE_PLAN.md §10.3.
param enableSchedules = true

// Killswitch module enabled on deploy (true = Logic App + Action Group + RBAC deployed).
// Enabled by default per operator decision (2026-05-31): full killswitch chain deploys
// to dev automatically on merge to main and to prod on the next infra/v* tag push.
// Requires killswitchRbacRoleId to be set to the pre-created custom role GUID.
// See: infra/COST_KILLSWITCH_PLAN.md §3/PR-KS1
param enableKillswitch = true

// GUID of the pre-created "ACA Job Schedule Manager" custom role.
// OPERATOR: fill in after running:
//   az role definition create --role-definition '{
//     "Name": "ACA Job Schedule Manager",
//     "Actions": ["Microsoft.App/jobs/read","Microsoft.App/jobs/write","Microsoft.App/jobs/stop/action"],
//     "AssignableScopes": ["/subscriptions/3f82c7e1-4b1b-4a55-b905-d79f65c6887d"]
//   }'
// Custom role created by operator 2026-05-31; this is its GUID. The killswitch
// module now ARMS on the next dev auto-deploy (Logic App + Action Group + cross-RG RBAC).
// See: infra/COST_KILLSWITCH_PLAN.md §3/PR-KS1 (operator pre-step)
param killswitchRbacRoleId = '3e2d5a14-96bd-4469-9f96-b9c3270aa9e6'
