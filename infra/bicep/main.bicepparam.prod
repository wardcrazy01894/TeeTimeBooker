// main.bicepparam.prod — production environment parameter values.
// Deploy: az deployment group create \
//   --resource-group rg-teetime-prod \
//   --template-file infra/bicep/main.bicep \
//   --parameters @infra/bicep/main.bicepparam.prod
//
// See: infra/AZURE_PLAN.md §4 (parameter strategy), §10.2 (deploy workflow),
//      §12 (open questions)

using 'main.bicep'

param envName = 'prod'
param location = 'eastus2'

// containerImage is a placeholder for local/manual deploy only — CI injects containerImage
// inline (resolved from the ACR login server after ACR creation); this placeholder is never
// read by CI. Pin to explicit image tag (not :latest) in prod. Format: <acrLoginServer>/teetime:<semver>
// AZURE_PLAN.md §10.2 — image tag is the release artifact.
param containerImage = 'PLACEHOLDER_ACR_LOGIN_SERVER/teetime:PLACEHOLDER_VERSION'

// Budget params are NOT set here. budget.bicep is subscription-scoped and
// deployed separately. See AZURE_PLAN.md §9.2.

param kvSku = 'standard'

// Shared-ACR consolidation: prod is a NON-OWNER — it pulls from the single shared ACR in the
// DEDICATED rg-teetime-shared (deployed separately) and pushes to its `teetime` repo there
// (dev uses `teetime-dev`). CI resolves the name at deploy time; these are for manual deploys.
// See AZURE_PLAN.md §2.1 + infra/bicep/modules/acr-pull-cross-rg.bicep.
param sharedAcrName = 'teetimesharedhe44piukeamjk'
param sharedAcrResourceGroup = 'rg-teetime-shared'

// Prod runs real bookings (no dry-run). Flip to false only at production cutover.
// Left explicit (matches the param default) so the intent is visible in review.
param dryRun = false

// Prod keeps Key Vault purge protection ON — irreversible-delete guard. Once
// enabled this cannot be turned off for the vault's lifetime. See AZURE_PLAN.md §11.
param enablePurgeProtection = true

// Cost-killswitch safety latch. Defaults false (schedules run normally).
// If the $50 budget killswitch fires: set this to true in BOTH param files and push.
// CI parses THIS value out of the param file and passes it into every deploy, so
// effectiveEnableSchedules (= enableSchedules && !killswitchFired) goes false and no
// subsequent merge can re-arm the cron schedules until this bit is cleared.
// WARNING: do NOT clear this param until the overspend root cause is resolved.
// See: docs/plans/COST_KILLSWITCH_PLAN.md §2/Item2 + §5 (operator runbook)
param killswitchFired = false

// Cron schedules on/off. Default true (booking + watch jobs auto-fire). CI parses this
// from the param file (the other half of effectiveEnableSchedules). See AZURE_PLAN.md §10.3.
param enableSchedules = true

// Killswitch module enabled on deploy (true = Logic App + Action Group + RBAC deployed).
// Enabled by default per operator decision (2026-05-31): full killswitch chain deploys
// to prod on the next infra/v* tag push. Requires killswitchRbacRoleId to be set.
// NOTE: the killswitch Logic App lives ONLY in rg-teetime-dev (dev deploy). This
// param is read by main.bicep but the killswitch module is gated to envName=='dev',
// so prod deploys never create a second Logic App. The prod param is kept in sync
// for parity and future reference.
// See: docs/plans/COST_KILLSWITCH_PLAN.md §2/Item3, §3/PR-KS1
param enableKillswitch = true

// GUID of the pre-created "ACA Job Schedule Manager" custom role.
// Same value as dev param file — the custom role is subscription-scoped (usable across both RGs).
// Same value as dev param file. NOTE: the killswitch module is gated on envName=='dev', so the
// prod deploy never creates a killswitch — this value is unused in prod, set only for parity.
// See: docs/plans/COST_KILLSWITCH_PLAN.md §3/PR-KS1 (operator pre-step)
param killswitchRbacRoleId = '3e2d5a14-96bd-4469-9f96-b9c3270aa9e6'

// --- MU-18 (MULTIUSER_PLAN §11 steps 5-7, AZURE_PLAN §10.8): the PROD cutover ------------------
// Stage A (infra/v2.17.0) turned on the web app, ACS email and the shared Cosmos endpoint while the
// jobs stayed TOML; the operator connected the account, created the weekly booking and adopted the
// live reservations (MU-16b). Stage B (this) runs `tenant-run --event mb0600et` and `tenant-watch`.
// Rollback: set both back to 'toml' and tag (AZURE_PLAN §10.8); TOML still has the MB credentials.
param bookingMode = 'tenant'
param watchMode = 'tenant'

// Prod watch cadence is UNCHANGED (every 10 min, year-round — AZURE_PLAN §5.4). Only dev goes
// hourly.
param watchCron = '*/10 * * * *'

// The shared free-tier account in rg-teetime-shared (MU-15b); the database is the env name
// (`prod`), where the prod MI holds its data-plane role. Empty sender = main.bicep derives it
// from the email module: hello@spicyteetimebooker.com (emailCustomDomainLinked below).
param tenantCosmosEndpoint = 'https://cosmos-teetime-shared.documents.azure.com:443/'
param acsEmailSender = ''

// Needs, in kv-teetime-prod-4jte: WEB-SESSION-SECRET, OAUTH-GOOGLE-CLIENT-ID/SECRET,
// TENANT-CREDS-KEYRING, OPERATOR-NOTIFY-EMAIL, and Key Vault Secrets Officer for the CI SP (so
// email.bicep can write ACS-EMAIL-CONNECTION), plus GITHUB-ISSUES-TOKEN (githubIssuesRepo). The
// URL is the custom domain and must match the Google client's redirect URI.
param deployWebApp = true
param deployAcsEmail = true
param webPublicBaseUrl = 'https://spicyteetimebooker.com'
// Custom domain (2026-09-28): apex + www bound with managed certs (created once by the AZURE_PLAN
// §10.9 runbook); www and the old teetime-web-prod.wittydesert-02f9f0cd.eastus2
// .azurecontainerapps.io host redirect here. The Google OAuth client must list
// https://spicyteetimebooker.com/auth/google/callback.
param webCustomDomain = 'spicyteetimebooker.com'
// Mail from hello@spicyteetimebooker.com (2026-09-29). Stage 1: the domain is created; its DNS
// records (main.bicep output emailCustomDomainRecords) go into Cloudflare and are verified
// (AZURE_PLAN runbook). Stage 2 (2026-09-29, after Domain/SPF/DKIM/DKIM2 all showed Verified):
// linked, so the sender is "Spicy's Tee Time Booker" <hello@spicyteetimebooker.com>.
param emailCustomDomain = 'spicyteetimebooker.com'
param emailCustomDomainLinked = true
// Site reports (Report a bug / Request a course) -> anonymized issues here (2026-09-29). Needs
// the GITHUB-ISSUES-TOKEN Key Vault secret (created by the operator).
param githubIssuesRepo = 'wardcrazy01894/TeeTimeBooker'
// Always warm (operator decision 2026-09-28): one idle-billed replica, ~$6/month, so a visitor
// never waits out the ~30 s scale-from-zero cold start. The killswitch still forces 0.
param webMinReplicas = 1
// Empty = the web reads OPERATOR-NOTIFY-EMAIL from Key Vault (the repo is public).
param operatorEmail = ''
