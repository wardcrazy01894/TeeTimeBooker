# Local development environment variables.
#
# Copy to `.env` (gitignored) and edit, then load with:
#   set -a && source .env && set +a
# Wrap values with special characters (&, !, $) in single quotes.
# Or use direnv: add `dotenv` to .envrc and run `direnv allow`.
# These names mirror the *_env references in config/example.toml. Required
# for `uv run teetime show-config` to load successfully. The CLI's
# --use-fake-adapter mode does NOT need real ForeUP/SMTP credentials, so
# placeholder values are fine for local demos.

# --- ForeUP credentials (real ones for live runs; placeholders for fakes) ---
MB_USERNAME=your-foreup-username
MB_PASSWORD=your-foreup-password

# --- Player 1 (you) ---
PLAYER1_EMAIL=you@example.com
PLAYER1_PHONE=555-0001
PLAYER1_MB_MEMBER=00000

# --- Player 2 (optional second golfer) ---
PLAYER2_EMAIL=guest@example.com

# --- Players 3 & 4 (fill the 4-player party) ---
PLAYER3_EMAIL=guest3@example.com
PLAYER4_EMAIL=guest4@example.com

# --- TeeItUp credentials (e.g. Sydney R. Marovitz Golf Course) ---
# Native TeeItUp accounts use direct card entry; card details go to tr.gnsvc.com (not stored by TeeItUp).
SM_USERNAME=your-teeitup-email
SM_PASSWORD=your-teeitup-password
SM_CVV=your-cvv
SM_CARD_NUMBER=your-card-number
SM_EXPIRY_MONTH=MM
SM_EXPIRY_YEAR=YYYY
SM_BILLING_ADDRESS=your-billing-address
SM_BILLING_POSTAL_CODE=your-zip

# --- SMTP for email notifications ---
# For local --use-fake-adapter runs these can be placeholders. Real cron runs
# need a working SMTP; Gmail App Passwords are the v0-friendly option.
# DEFERRED for v1: config/container.toml uses backend="console" until ready.
SMTP_HOST=smtp.gmail.com
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-app-password

# --- CAPTCHA solver (required for --dry-run false) ---
# Sign up at https://2captcha.com, add $2-5 credit (~$0.003/solve, cents/year).
# If unset the bot falls back to Playwright browser automation, which Google
# often rejects. Strongly recommended: set this.
TWOCAPTCHA_API_KEY=your-2captcha-api-key

# --- Azure (v1 hosting — not needed for local `uv run` or --use-fake-adapter) ---
# These go into GitHub secrets for CI (AZURE_CLIENT_ID, AZURE_TENANT_ID,
# AZURE_SUBSCRIPTION_ID). Populate locally if you want to run `az` CLI commands
# without retyping them. See infra/AZURE_PLAN.md §8.2 for the full setup runbook.
# Note: tenant and subscription IDs are configuration identifiers, not credentials —
# they cannot authenticate anyone on their own.
AZURE_TENANT_ID=your-tenant-id
AZURE_SUBSCRIPTION_ID=your-subscription-id
# AZURE_CLIENT_ID is created during the one-time OIDC setup (az ad app create).
# Leave blank until that step is complete; then fill in the app's appId.
AZURE_CLIENT_ID=your-oidc-app-client-id
